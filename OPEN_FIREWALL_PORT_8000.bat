@echo off
chcp 65001 >nul
title کردنەوەی پۆرتی فایەروۆڵ بۆ سیستەم
color 0E
cls

echo ======================================================================
echo           کردنەوەی پۆرتی 8000 لە فایەروۆڵی ویندۆز
echo ======================================================================
echo.
echo تکایە دڵنیابە ئەم فایلەت بە (Run as administrator) کردووەتەوە!
echo.

netsh advfirewall firewall add rule name="Tourist Car System (Port 8000)" dir=in action=allow protocol=TCP localport=8000

echo.
echo ======================================================================
echo ئەگەر سەرەوە نووسرا (Ok.)، کەواتە پۆرتەکە کرایەوە و بەشەکانی تر دەتوانن
echo ڕاستەوخۆ بەسترێنەوە بە سێرڤەرەکە بەبێ کێشە.
echo ======================================================================
pause
