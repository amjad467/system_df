@echo off
chcp 65001 >nul
title سیستەمی دەفتەری ئۆتۆمبێلی گەشتیاری - سێرڤەری سەرەکی
color 0A
cls

echo ======================================================================
echo    دەستەی گومرگی سلێمانی - بەشی دەفتەری ئۆتۆمبێلی گەشتیاری
echo               سێرڤەری سەرەکی دەستی پێکرد
echo ======================================================================
echo.

:: دۆزینەوەی ئایپی ناوخۆیی کۆمپیوتەرەکە
for /f "tokens=2 delims=:" %%a in ('ipconfig ^| findstr /c:"IPv4"') do (
    set IP=%%a
    goto :found_ip
)

:found_ip
set IP=%IP: =%

echo [1] زانیاری بەستنەوە بۆ بەشەکانی تر:
echo ----------------------------------------------------------------------
echo  تکایە لە کۆمپیوتەری بەشەکانی تر (داتائینتری، پشکنین، ووردبینی، حیسابات، چاپ)
echo  لە وێبگەڕی کڕۆم یان ئێج ئەم ناونیشانە بنووسە:
echo.
echo       http://%IP%:8000
echo.
echo ----------------------------------------------------------------------
echo [2] پشکنینی ڕێڕەوی فایەروۆڵ:
echo  ئەگەر لە بەشەکانی تر نەکرایەوە، دڵنیابە لە کردنەوەی پۆرتی 8000 لە Windows Firewall
echo.
echo [3] سێرڤەرەکە ئێستا چالاکە... بۆ کوژاندنەوە، ئەم پەنجەرەیە دابخە.
echo ======================================================================
echo.

php artisan serve --host=0.0.0.0 --port=8000

pause
